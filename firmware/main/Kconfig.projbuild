menu "BLE test instrumentation"
config BLE_TEST_DIAGNOSTICS
    bool "Read-only bounded BLE diagnostic characteristic (test builds only)"
    default n
    help
        Adds c0de0005 and queue timestamps/counters. Does not change the
        fixed 20-byte v1 protocol. Disable for normal production builds.
config BLE_EVENT_SCHEDULER
    bool "Experimental event/resource notify scheduler"
    depends on BLE_TEST_DIAGNOSTICS
    default n
    help
        Bench A/B only. The 12/24/36 pool candidates still failed overloaded
        control deadlines; keep the previous scheduler as the normal fallback.
config BLE_CONNECTION_POLICY
    int "Test connection profile (0=default, 1=15-30ms, 2=7.5-15ms)"
    depends on BLE_TEST_DIAGNOSTICS
    range 0 2
    default 0
    help
        Observe the central first, then request once after subscription.
        Only immediate local rejection permits one retry. No PHY/MTU changes.
        Keep disabled normally: overload ingress accounting remains unresolved.
endmenu

menu "CAN analyzer status LED"
config CAN_STATUS_LED
    bool "GPIO3 communication indicator (active high)"
    depends on IDF_TARGET_ESP32S3
    default y
    help
        Use the separate GPIO3 LED even when the local panel is disabled.
        Off without a wireless client/peer, steady on when connected, and
        short off pulses on successful CAN RX/TX (at most five per second).
endmenu

menu "CAN analyzer local panel"
config CAN_LOCAL_PANEL
    bool "ST7789 screen, buttons, backlight and buzzer"
    depends on IDF_TARGET_ESP32S3
    default y
config CAN_LCD_X_GAP
    int "ST7789 column offset"
    depends on CAN_LOCAL_PANEL
    range 0 68
    default 34
config CAN_LCD_Y_GAP
    int "ST7789 row offset"
    depends on CAN_LOCAL_PANEL
    range 0 0
    default 0
config CAN_LCD_INVERT
    bool "Invert panel colors (typical IPS panel)"
    depends on CAN_LOCAL_PANEL
    default y
config CAN_LCD_BGR
    bool "Use BGR instead of RGB color order"
    depends on CAN_LOCAL_PANEL
    default n
endmenu
